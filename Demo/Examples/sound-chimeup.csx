var receipt = await NotificationClient.SendAsync(new() { Title = "Completed sound", Message = "Listen to this sound override on the Daily theme.", Theme = NotificationThemes.Daily, Overrides = new() { Sound = new(NotificationSounds.Completed), Lifetime = new(new ExpiringLifetime(TimeSpan.FromSeconds(8))) } }, cancellationToken: token);
Print(receipt);
if (receipt.Accepted) Print(await NotificationClient.WaitAsync(receipt, cancellationToken: token));