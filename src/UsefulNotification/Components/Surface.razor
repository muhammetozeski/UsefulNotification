@implements IDisposable
@inject IJSRuntime JavaScript
@using Windows.Win32
<style>@((MarkupString)ThemeStyle.Render())</style>
@if (Toast)
{
    <style>body { zoom: @ContentScale.ToString(System.Globalization.CultureInfo.InvariantCulture); }</style>
    <main class="toast-stack">@foreach (var entry in Active) { <NotificationCard Entry="entry" Toast="true" @key="entry.Id" /> }</main>
}
else if (App.Host.IsPanelVisible)
{
    <main class="shell" @onkeydown="KeyDown">
        <header class="window-header">
            <div class="window-drag-region" data-window-hit="@PInvoke.HTCAPTION"><svg class="app-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /></svg><strong>@AppConstants.Product.Name</strong></div>
            <button title="@Strings.Minimize" aria-label="@Strings.Minimize" @onclick="App.Host.Minimize">&#x2212;</button>
            <button title="@Strings.CloseToTray" aria-label="@Strings.CloseToTray" @onclick="ClosePanel">&#x2715;</button>
        </header>
        <div class="workspace">
            <nav class="sidebar" aria-label="@Strings.Navigation">
                @foreach (PanelSection section in Enum.GetValues<PanelSection>())
                {
                    <button class="nav-button" aria-current="@(Section == section ? "page" : null)" @onclick="() => Navigate(section)"><span>@SectionLabel(section)</span>@if (SectionCount(section) is { } count) { <small>@count</small> }</button>
                }
            </nav>
            <section class="page">
                <header class="page-header"><h1>@SectionLabel(Section)</h1>@if (IsList && Editing is null) { <button class="primary" @onclick="() => NewNotification()">+ @Strings.NewNotificationTitle</button> }</header>
                @if (Error is not null) { <p class="error" role="alert">@Error</p> }
                @if (Status is not null) { <p class="status" role="status">@Status</p> }
                @if (IsList)
                {
                    @if (Editing is not null)
                    {
                        <div class="content"><NotificationEditor @key="Editing" Request="Editing" Saved="SaveNotification" Canceled="CancelEdit" DirtyChanged="value => EditorDirty = value" /></div>
                    }
                    else
                    {
                        <div class="toolbar">
                            <label class="field search-field">@Strings.Search<input type="search" placeholder="@Strings.Search" @bind="Search" @bind:event="oninput" /></label>
                            <label class="field">@Strings.Level<select @bind="Level"><option value="">@Strings.All</option>@foreach (NotificationLevel level in Enum.GetValues<NotificationLevel>()) { <option value="@level">@ThemeStyle.Label(level)</option> }</select></label>
                            <label class="field">@Strings.Sort<select @bind="Sort">@foreach (SortOrder order in Enum.GetValues<SortOrder>()) { <option value="@order">@ThemeStyle.Label(order)</option> }</select></label>
                        </div>
                        @if (Section != PanelSection.History)
                        {
                            <div class="quick"><span class="muted">@Strings.QuickReminder</span>@foreach (TimeSpan delay in AppConstants.Notifications.QuickDelays) { <button @onclick="() => NewNotification(delay)">@string.Format(Strings.MinuteFormat, delay.TotalMinutes)</button> }</div>
                        }
                        <div class="list-heading"><small>@string.Format(Strings.NotificationCount, Filtered.Count())</small><div class="row">@if (Section == PanelSection.History) { <button disabled="@(!Filtered.Any())" @onclick="Clear">@Strings.ClearHistory</button> } else if (Section == PanelSection.Inbox) { <button disabled="@(!Active.Any())" @onclick="DismissAll">@Strings.DismissAll</button> }</div></div>
                        <div class="content">
                            <div class="list">
                                @foreach (var entry in Filtered.Skip(Page * AppConstants.Storage.HistoryPageSize).Take(AppConstants.Storage.HistoryPageSize))
                                {
                                    <NotificationCard Entry="entry" Edit="Edit" DeleteRequested="Delete" History="@(Section == PanelSection.History)" ManualOrder="@(Sort == SortOrder.Manual)" @key="entry.Id" />
                                }
                                @if (!Filtered.Any()) { <div class="empty"><h2>@(Search.Length > 0 || Level is not null ? Strings.NoMatchingNotifications : EmptyLabel)</h2>@if (Search.Length > 0 || Level is not null) { <button @onclick="ResetFilters">@Strings.ResetFilters</button> }</div> }
                            </div>
                        </div>
                        @if (Filtered.Count() > AppConstants.Storage.HistoryPageSize) { <footer class="pagination"><button disabled="@(Page == 0)" @onclick="() => Page--">@Strings.HistoryPrevious</button><small>@string.Format(Strings.PageNumber, Page + 1, PageCount)</small><button disabled="@(Page + 1 >= PageCount)" @onclick="() => Page++">@Strings.HistoryNext</button></footer> }
                    }
                }
                else if (Section == PanelSection.Sounds)
                {
                    <div class="content"><SoundEditor DirtyChanged="value => SoundDirty = value" /></div>
                }
                else
                {
                    <div class="content settings">
                        <fieldset class="form-section"><legend>@Strings.AppearanceOptions</legend><div class="form-grid">
                            <label class="field">@Strings.Theme<select @bind="SettingsDraft.Theme">@foreach (var theme in ThemeCatalog.Themes) { <option value="@theme.Name">@theme.Name</option> }</select></label>
                            <label class="field">@Strings.Language<select @bind="SettingsDraft.Language"><option value="@LocManager.SystemLanguage">@Strings.SystemLanguage</option>@foreach (var language in LocManager.Available) { <option value="@language.Code">@language.Name</option> }</select></label>
                        </div></fieldset>
                        <fieldset class="form-section"><legend>@Strings.DeliveryOptions</legend><div class="form-grid">
                            <label class="field">@Strings.MaximumVisible<input type="number" min="1" @bind="SettingsDraft.MaximumVisible" /></label>
                            <label class="field">@Strings.Monitor<select @bind="SettingsDraft.Monitor"><option value="0">@Strings.AutomaticMonitor</option>@foreach (var monitor in App.Host.Monitors) { <option value="@monitor.Index">@monitor.Name</option> }</select></label>
                            <label class="check"><input type="checkbox" @bind="SettingsDraft.PlaySound" />@Strings.PlaySound</label>
                            <label class="check"><input type="checkbox" @bind="SettingsDraft.PauseOnHover" />@Strings.PauseOnHover</label>
                        </div></fieldset>
                        <fieldset class="form-section"><legend>@Strings.ApplicationOptions</legend><div class="form-grid">
                            <label class="check"><input type="checkbox" @bind="SettingsDraft.GlobalHotkey" />@Strings.GlobalHotkey</label>
                            <label class="check"><input type="checkbox" @bind="SettingsDraft.StartWithWindows" />@Strings.StartWithWindows</label>
                            <label class="check"><input type="checkbox" @bind="SettingsDraft.EnableLogging" />@Strings.Logging</label>
                        </div></fieldset>
                        <div class="actions"><button class="primary" disabled="@(SettingsDraft == App.Hub.Configuration)" @onclick="SaveSettings">@Strings.Save</button><button disabled="@(SettingsDraft == App.Hub.Configuration)" @onclick="ResetSettings">@Strings.ResetChanges</button></div>
                        <details class="form-section"><summary>@Strings.CustomizationFiles</summary><div class="actions"><button @onclick="() => OpenDirectory(AppPaths.UserData)">@Strings.OpenData</button><button @onclick="() => OpenDirectory(Path.Combine(AppPaths.UserData, AppConstants.Storage.ThemesDirectory))">@Strings.OpenThemes</button><button @onclick="() => OpenDirectory(Path.Combine(AppPaths.UserData, AppConstants.Storage.TemplatesDirectory))">@Strings.OpenTemplates</button><button @onclick="() => RequestLeave(Reload)">@Strings.Reload</button></div></details>
                        <div class="application-exit"><button class="danger" @onclick="() => RequestLeave(App.Host.Exit)">@Strings.ExitApplication</button></div>
                    </div>
                }
            </section>
        </div>
        <span class="resize-edge left" data-window-hit="@PInvoke.HTLEFT"></span><span class="resize-edge right" data-window-hit="@PInvoke.HTRIGHT"></span><span class="resize-edge top" data-window-hit="@PInvoke.HTTOP"></span><span class="resize-edge bottom" data-window-hit="@PInvoke.HTBOTTOM"></span><span class="resize-edge top-left" data-window-hit="@PInvoke.HTTOPLEFT"></span><span class="resize-edge top-right" data-window-hit="@PInvoke.HTTOPRIGHT"></span><span class="resize-edge bottom-left" data-window-hit="@PInvoke.HTBOTTOMLEFT"></span><span class="resize-edge bottom-right" data-window-hit="@PInvoke.HTBOTTOMRIGHT"></span>
        @if (Confirmation is { } confirmation)
        {
            <div class="dialog-backdrop"><section class="dialog" role="alertdialog" aria-modal="true" aria-labelledby="confirmation-title"><h2 id="confirmation-title">@confirmation.Title</h2><p>@confirmation.Message</p><div class="actions"><button autofocus @onclick="() => Confirmation = null">@Strings.Cancel</button><button class="danger" @onclick="Confirm">@confirmation.Button</button></div></section></div>
        }
    </main>
}

@code {
    enum PanelSection { Inbox, Scheduled, History, Sounds, Settings }
    enum SortOrder { Newest, Oldest, Priority, NextDue, Manual }
    sealed record PendingConfirmation(string Title, string Message, string Button, Action Execute);
    [Parameter] public bool Toast { get; set; }
    List<NotificationEntry> Entries = [];
    RuntimeSettings SettingsDraft = App.Hub.Configuration with { };
    PanelSection Section;
    SortOrder SelectedSort;
    NotificationLevel? SelectedLevel;
    string SearchText = string.Empty;
    int Page;
    int PageCount => Math.Max(1, (Filtered.Count() + AppConstants.Storage.HistoryPageSize - 1) / AppConstants.Storage.HistoryPageSize);
    string Search { get => SearchText; set { SearchText = value; Page = 0; } }
    NotificationLevel? Level { get => SelectedLevel; set { SelectedLevel = value; Page = 0; } }
    SortOrder Sort { get => SelectedSort; set { SelectedSort = value; Page = 0; } }
    bool IsList => Section is PanelSection.Inbox or PanelSection.Scheduled or PanelSection.History;
    bool EditorDirty, SoundDirty;
    bool HasChanges => EditorDirty || SoundDirty || Section == PanelSection.Settings && SettingsDraft != App.Hub.Configuration;
    string? Error, Status;
    NotificationRequest? Editing;
    PendingConfirmation? Confirmation;
    DotNetObjectReference<Surface>? Reference;
    double ContentScale = 1;
    IEnumerable<NotificationEntry> Active => Entries.Where(entry => entry.Status == NotificationStatus.Visible || entry.Status == NotificationStatus.Pending && entry.DeliveryStartedAt is not null).OrderByDescending(entry => entry.Request.Priority).ThenBy(entry => entry.Order);
    IEnumerable<NotificationEntry> Filtered
    {
        get
        {
            IEnumerable<NotificationEntry> selected = Section switch
            {
                PanelSection.Inbox => Entries.Where(entry => entry.Status is NotificationStatus.Visible or NotificationStatus.Pending),
                PanelSection.Scheduled => Entries.Where(entry => entry.Status is NotificationStatus.Scheduled or NotificationStatus.Snoozed),
                PanelSection.History => Entries.Where(entry => entry.Result is not null).Select(entry => entry with { Occurrences = entry.Occurrences.Where(item => item.Result is not null).ToList() }),
                _ => []
            };
            selected = selected.Where(entry => Level is null || entry.Request.Level == Level).Where(entry => string.IsNullOrWhiteSpace(Search) || $"{entry.Request.Source} {entry.Request.Title} {entry.Request.Message}".Contains(Search, StringComparison.CurrentCultureIgnoreCase));
            return Sort switch { SortOrder.Oldest => selected.OrderBy(entry => entry.Current.ClosedAt ?? entry.CreatedAt), SortOrder.Priority => selected.OrderByDescending(entry => entry.Request.Priority), SortOrder.NextDue => selected.OrderBy(entry => entry.DueAt), SortOrder.Manual => selected.OrderBy(entry => entry.Order), _ => selected.OrderByDescending(entry => entry.Current.ClosedAt ?? entry.CreatedAt) };
        }
    }
    string EmptyLabel => Section switch { PanelSection.Scheduled => Strings.NoScheduledNotifications, PanelSection.History => Strings.NoHistory, _ => Strings.NoActiveNotifications };
    int? SectionCount(PanelSection section) => section switch { PanelSection.Inbox => Entries.Count(entry => entry.Status is NotificationStatus.Pending or NotificationStatus.Visible), PanelSection.Scheduled => Entries.Count(entry => entry.Status is NotificationStatus.Scheduled or NotificationStatus.Snoozed), PanelSection.History => Entries.Count(entry => entry.Result is not null), _ => null };
    static string SectionLabel(PanelSection section) => section switch { PanelSection.Inbox => Strings.Inbox, PanelSection.Scheduled => Strings.Scheduled, PanelSection.History => Strings.History, PanelSection.Sounds => Strings.Sounds, _ => Strings.SettingsTitle };

    protected override void OnInitialized()
    {
        Entries = App.Hub.Snapshot(); App.Hub.Changed += Changed; LocManager.LanguageChanged += Changed;
        if (!Toast) App.Host.CloseRequested += NativeClose;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) { Reference = DotNetObjectReference.Create(this); await JavaScript.InvokeVoidAsync("notificationSurface.observe", Reference); }
        if (Toast && ContentScale != App.Host.ToastContentScale) { ContentScale = App.Host.ToastContentScale; StateHasChanged(); return; }
        App.Host.SurfacePrepared(Toast, Active.Select(entry => entry.Id));
        if (Toast) await JavaScript.InvokeVoidAsync("notificationSurface.report");
        else await JavaScript.InvokeVoidAsync("notificationSurface.focusDialog");
    }
    [JSInvokable] public void BeginWindowInteraction(uint hit) => RunSafely(() => App.Host.BeginWindowInteraction(hit));
    [JSInvokable] public void UpdateWindowInteraction() => RunSafely(App.Host.UpdateWindowInteraction);
    [JSInvokable] public void EndWindowInteraction() => App.Host.EndWindowInteraction();
    [JSInvokable] public void ContentResized(double height) { if (Toast && Active.Any()) App.Host.ResizeToast(height); }
    [JSInvokable] public void CardsRendered(RenderReceipt[] receipts) => RunSafely(() => App.Host.ConfirmRendered(receipts));
    [JSInvokable] public async Task TemplateAction(string id, string occurrenceId, long revision, string action, string reply) => await RunSafelyAsync(async token =>
    {
        var entry = Entries.Single(item => item.Id == Guid.Parse(id));
        NotificationAction? selected = action == AppConstants.HtmlTemplates.DismissAction ? null : entry.Request.Actions.Single(item => item.Id == action);
        await App.Hub.InteractAsync(entry.Id, selected, reply, occurrenceId: Guid.Parse(occurrenceId), revision: revision);
    });
    async void Changed() => await RunSafelyAsync(async token => await InvokeAsync(() => { Entries = App.Hub.Snapshot(); Page = Math.Min(Page, PageCount - 1); StateHasChanged(); }));
    async void NativeClose() => await RunSafelyAsync(async token => await InvokeAsync(() => { ClosePanel(); StateHasChanged(); }));
    void RequestLeave(Action action)
    {
        void Leave() { Editing = null; EditorDirty = false; SoundDirty = false; SettingsDraft = App.Hub.Configuration with { }; action(); }
        if (HasChanges) Confirmation = new(Strings.UnsavedChanges, Strings.DiscardChangesQuestion, Strings.DiscardChanges, Leave); else Leave();
    }
    void Navigate(PanelSection section) { if (Section == section) return; RequestLeave(() => { Section = section; Editing = null; EditorDirty = false; SoundDirty = false; Page = 0; Error = null; Status = null; SettingsDraft = App.Hub.Configuration with { }; }); }
    void ClosePanel() => RequestLeave(() => App.Host.ShowPanel(false));
    void Confirm() { var pending = Confirmation; Confirmation = null; if (pending is not null) RunSafely(pending.Execute); }
    void KeyDown(KeyboardEventArgs args) { if (args.Key == "Escape") { if (Confirmation is not null) Confirmation = null; else if (Editing is not null) CancelEdit(); } }
    void ResetFilters() { Search = string.Empty; Level = null; }
    void NewNotification(TimeSpan? delay = null) => RequestLeave(() => { Editing = delay is { } after ? new() { Schedule = new() { At = DateTimeOffset.Now.Add(after) }, Lifetime = NotificationLifetimes.UntilAcknowledged } : new(); EditorDirty = false; Status = null; Error = null; });
    void Edit(NotificationEntry entry) => RequestLeave(() => { Editing = Section == PanelSection.History ? NotificationProtocol.Copy(entry.Request) with { Id = null, Tag = null, Schedule = null } : NotificationProtocol.Copy(entry.Request) with { Id = entry.Id }; EditorDirty = false; });
    void CancelEdit() => RequestLeave(() => { Editing = null; EditorDirty = false; });
    void Delete(NotificationEntry entry) => Confirmation = new(Strings.DeleteNotification, entry.Request.Title ?? Strings.NewNotificationTitle, Strings.Delete, () => App.Hub.Apply(new() { Operation = Section == PanelSection.History ? NotificationOperation.ClearHistory : NotificationOperation.Delete, Id = entry.Id, OccurrenceId = Section == PanelSection.History ? entry.Current.Id : null }));
    void Clear() => Confirmation = new(Strings.ClearHistory, Strings.ClearHistoryQuestion, Strings.ClearHistory, () => App.Hub.Apply(new() { Operation = NotificationOperation.ClearHistory }));
    void DismissAll() => RunSafely(() => { foreach (var entry in Entries.Where(item => item.Status is NotificationStatus.Visible or NotificationStatus.Pending).ToArray()) App.Hub.Apply(new() { Operation = NotificationOperation.Dismiss, Id = entry.Id }); });
    void SaveNotification(NotificationRequest request)
    {
        var result = RunSafely(() => App.Hub.Apply(new() { Operation = Entries.Any(item => item.Id == request.Id) ? NotificationOperation.Replace : NotificationOperation.Send, Id = request.Id, Notification = request }));
        if (result.Succeeded) { Editing = null; EditorDirty = false; Status = Strings.NotificationSaved; }
        Error = result.Succeeded ? null : Strings.OperationFailed;
    }
    void SaveSettings()
    {
        Status = null;
        var result = RunSafely(() => App.Hub.SaveConfiguration(SettingsDraft with { }));
        if (result.Succeeded) { SettingsDraft = App.Hub.Configuration with { }; Status = Strings.SettingsSaved; }
        Error = result.Succeeded ? null : Strings.OperationFailed;
    }
    void ResetSettings() { SettingsDraft = App.Hub.Configuration with { }; Error = null; Status = null; }
    void Reload() { var result = RunSafely(() => App.Hub.Apply(new() { Operation = NotificationOperation.ReloadSettings })); if (result.Succeeded) { ResetSettings(); Status = Strings.SettingsSaved; } else Error = Strings.OperationFailed; }
    static void OpenDirectory(string path) => RunSafely(() => { Directory.CreateDirectory(path); using Process? explorer = Process.Start(new ProcessStartInfo(path) { UseShellExecute = true }); });
    public void Dispose() { App.Hub.Changed -= Changed; LocManager.LanguageChanged -= Changed; if (!Toast) App.Host.CloseRequested -= NativeClose; Reference?.Dispose(); }
}
