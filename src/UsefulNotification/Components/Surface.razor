@implements IDisposable
@inject IJSRuntime JavaScript
<style>@((MarkupString)ThemeStyle.Render())</style>
@if (Toast) { <style>body { zoom: @ContentScale.ToString(System.Globalization.CultureInfo.InvariantCulture); }</style> }
@if (Toast)
{
    <main class="toast-stack">@foreach (var entry in Active) { <NotificationCard Entry="entry" Toast="true" @key="entry.Id" /> }</main>
}
else
{
    <main class="shell">
        <header class="window-header" @onmousedown="() => App.Host.Drag()"><strong>@AppConstants.Product.Name</strong><button title="@Strings.Close" @onmousedown:stopPropagation @onclick="() => App.Host.ShowPanel(false)">&#x2715;</button></header>
        <nav class="tabs">
            @foreach (PanelSection section in Enum.GetValues<PanelSection>()) { <button class="@(Section == section ? "selected" : null)" @onclick="() => Section = section">@SectionLabel(section)</button> }
        </nav>
        @if (Section is PanelSection.Inbox or PanelSection.Scheduled)
        {
            <div class="toolbar"><input placeholder="@Strings.Search" @bind="Search" @bind:event="oninput" /><select @bind="Level"><option value="">@Strings.All</option>@foreach (NotificationLevel level in Enum.GetValues<NotificationLevel>()) { <option value="@level">@ThemeStyle.Label(level)</option> }</select><select @bind="Sort">@foreach (SortOrder order in Enum.GetValues<SortOrder>()) { <option value="@order">@SortLabel(order)</option> }</select><button class="primary" @onclick="() => Editing = new()">@Strings.New</button></div>
        }
        <section class="content">
            @if (Error is not null) { <div class="error">@Error</div> }
            @switch (Section)
            {
                case PanelSection.Inbox:
                case PanelSection.Scheduled:
                    @if (Editing is not null) { <NotificationEditor Request="Editing" Saved="SaveNotification" Canceled="() => Editing = null" /> }
                    <div class="quick">@foreach (TimeSpan delay in AppConstants.Notifications.QuickDelays) { <button @onclick="() => Quick(delay)">+@string.Format(Strings.MinuteFormat, delay.TotalMinutes)</button> }<button @onclick="Clear">@Strings.ClearHistory</button><button @onclick="DismissAll">@Strings.DismissAll</button></div>
                    <div class="list">
                        @foreach (var entry in Filtered) { <NotificationCard Entry="entry" Edit="Edit" @key="entry.Id" /> }
                        @if (!Filtered.Any()) { <p class="empty">@Strings.Empty</p> }
                    </div>
                    break;
                case PanelSection.Sounds:
                    <SoundEditor />
                    break;
                case PanelSection.Settings:
                    <div class="settings">
                        <div class="form-grid">
                            <label class="field">@Strings.Theme<select @bind="Settings.Theme.Value">@foreach (var theme in ThemeCatalog.Themes) { <option value="@theme.Name">@theme.Name</option> }</select></label>
                            <label class="field">@Strings.Language<select value="@Settings.Language.Value" @onchange="ChangeLanguage">@foreach (var language in LocManager.Available) { <option value="@language.Code">@language.Name</option> }</select></label>
                            <label class="field">@Strings.MaximumVisible<input type="number" min="1" @bind="Settings.MaximumVisible.Value" /></label>
                            <label class="field">@Strings.Monitor<input type="number" min="0" @bind="Settings.Monitor.Value" /></label>
                            <label class="check"><input type="checkbox" @bind="Settings.PlaySound.Value" />@Strings.PlaySound</label>
                            <label class="check"><input type="checkbox" @bind="Settings.PauseOnHover.Value" />@Strings.PauseOnHover</label>
                            <label class="check"><input type="checkbox" @bind="Settings.GlobalHotkey.Value" />@Strings.GlobalHotkey</label>
                            <label class="check"><input type="checkbox" @bind="Settings.EnableLogging.Value" />@Strings.Logging</label>
                        </div>
                        <div class="actions"><button class="primary" @onclick="SaveSettings">@Strings.Save</button><button @onclick="() => OpenDirectory(AppPaths.UserData)">@Strings.OpenData</button><button @onclick="() => OpenDirectory(Path.Combine(AppPaths.UserData, AppConstants.Storage.ThemesDirectory))">@Strings.OpenThemes</button><button @onclick="() => OpenDirectory(Path.Combine(AppPaths.UserData, AppConstants.Storage.TemplatesDirectory))">@Strings.OpenTemplates</button><button @onclick="Reload">@Strings.Reload</button><button @onclick="App.Host.Exit">@Strings.Exit</button></div>
                    </div>
                    break;
            }
        </section>
    </main>
}

@code {
    /// <summary>Identifies the panel's built-in work areas.</summary>
    enum PanelSection { Inbox, Scheduled, Sounds, Settings }
    /// <summary>Names user-selectable history orderings.</summary>
    enum SortOrder { Newest, Oldest, Priority, NextDue, Manual }
    [Parameter] public bool Toast { get; set; }
    List<NotificationEntry> Entries = [];
    PanelSection Section;
    SortOrder Sort;
    NotificationLevel? Level;
    string Search = string.Empty;
    string? Error;
    NotificationRequest? Editing;
    DotNetObjectReference<Surface>? Reference;
    double ContentScale = 1;
    IEnumerable<NotificationEntry> Active => Entries.Where(entry => entry.Status == NotificationStatus.Visible || entry.Status == NotificationStatus.Pending && entry.DeliveryStartedAt is not null).OrderByDescending(entry => entry.Request.Priority).ThenBy(entry => entry.Order);
    IEnumerable<NotificationEntry> Filtered
    {
        get
        {
            IEnumerable<NotificationEntry> selected = Entries.Where(entry => Section != PanelSection.Scheduled || entry.Status is NotificationStatus.Scheduled or NotificationStatus.Snoozed)
                .Where(entry => Level is null || entry.Request.Level == Level)
                .Where(entry => string.IsNullOrWhiteSpace(Search) || $"{entry.Request.Source} {entry.Request.Title} {entry.Request.Message}".Contains(Search, StringComparison.CurrentCultureIgnoreCase));
            return Sort switch { SortOrder.Oldest => selected.OrderBy(entry => entry.CreatedAt), SortOrder.Priority => selected.OrderByDescending(entry => entry.Request.Priority), SortOrder.NextDue => selected.OrderBy(entry => entry.DueAt), SortOrder.Manual => selected.OrderBy(entry => entry.Order), _ => selected.OrderByDescending(entry => entry.CreatedAt) };
        }
    }

    /// <summary>Subscribes this renderer to journal and language changes.</summary>
    protected override void OnInitialized()
    {
        Entries = App.Hub.Snapshot();
        App.Hub.Changed += Changed;
        LocManager.LanguageChanged += Changed;
    }

    /// <summary>Installs content observation and confirms only cards that reached an on-screen native surface.</summary>
    /// <param name="firstRender">Whether JavaScript observation must be installed.</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Reference = DotNetObjectReference.Create(this);
            await JavaScript.InvokeVoidAsync("notificationSurface.observe", Reference);
        }
        if (Toast && ContentScale != App.Host.ToastContentScale)
        {
            ContentScale = App.Host.ToastContentScale;
            StateHasChanged();
            return;
        }
        Guid[] rendered = Active.Select(entry => entry.Id).ToArray();
        App.Host.SurfacePrepared(Toast, rendered);
        App.Host.ConfirmRendered(rendered, Toast);
    }

    /// <summary>Receives the actual card-stack height rather than guessing from message length.</summary>
    /// <param name="height">Measured logical content height.</param>
    [JSInvokable] public void ContentResized(double height)
    {
        if (!Toast || !Active.Any()) return;
        App.Host.ResizeToast(height);
        App.Host.ConfirmRendered(Active.Select(entry => entry.Id).ToArray(), true);
    }

    /// <summary>Accepts only action identities already declared in that notification's contract.</summary>
    /// <param name="id">The frame's notification identity.</param>
    /// <param name="action">The declared action identity.</param>
    /// <param name="reply">Optional template reply.</param>
    [JSInvokable] public void TemplateAction(string id, string action, string reply) => RunSafely(() =>
    {
        var entry = Entries.Single(item => item.Id == Guid.Parse(id));
        App.Hub.Interact(entry.Id, entry.Request.Actions.Single(item => item.Id == action), reply);
    });

    /// <summary>Refreshes this renderer on its own Blazor dispatcher.</summary>
    async void Changed() => await RunSafelyAsync(async token => await InvokeAsync(() => { Entries = App.Hub.Snapshot(); StateHasChanged(); }));

    /// <summary>Loads a detached request into the editor.</summary>
    /// <param name="entry">The selected history or reminder item.</param>
    void Edit(NotificationEntry entry) => Editing = entry.Request with { Id = entry.Id };

    /// <summary>Commits a new notification or an edited request through the same command path as external clients.</summary>
    /// <param name="request">The editor's complete request.</param>
    void SaveNotification(NotificationRequest request)
    {
        var result = RunSafely(() => App.Hub.Apply(new() { Operation = Entries.Any(item => item.Id == request.Id) ? NotificationOperation.Update : NotificationOperation.Send, Id = request.Id, Notification = request }));
        if (result.Succeeded) Editing = null;
        Error = result.Succeeded ? null : Strings.OperationFailed;
    }

    /// <summary>Creates an editable quick reminder rather than requiring the user to enter every field.</summary>
    /// <param name="delay">The selected quick delay.</param>
    void Quick(TimeSpan delay) => Editing = new() { Kind = NotificationKind.Reminder, Schedule = new() { At = DateTimeOffset.Now.Add(delay) }, Sticky = true };

    /// <summary>Removes completed history while preserving active and future notifications.</summary>
    void Clear() => RunSafely(() => App.Hub.Apply(new() { Operation = NotificationOperation.Clear }));

    /// <summary>Acknowledges currently visible or pending notifications.</summary>
    void DismissAll() => RunSafely(() => { foreach (var entry in Entries.Where(item => item.Status is NotificationStatus.Visible or NotificationStatus.Pending)) App.Hub.Apply(new() { Operation = NotificationOperation.Dismiss, Id = entry.Id }); });

    /// <summary>Validates and persists settings, then reapplies native shortcuts and HTML appearance.</summary>
    void SaveSettings()
    {
        if (Settings.MaximumVisible.Value < 1 || Settings.Monitor.Value < 0) { Error = Strings.OperationFailed; return; }
        var result = ApplicationServices.SaveSettings();
        Error = result.Succeeded ? null : Strings.OperationFailed;
        if (result.Succeeded) { App.Host.InstallHotkey(); App.Hub.Tick(); StateHasChanged(); }
    }

    /// <summary>Applies and persists a language selection through the shared language boundary.</summary>
    /// <param name="args">The selected language code.</param>
    void ChangeLanguage(ChangeEventArgs args) { if (!ApplicationServices.ChangeLanguage(args.Value?.ToString() ?? LocManager.SystemLanguage).Succeeded) Error = Strings.OperationFailed; }

    /// <summary>Loads edited theme and settings files.</summary>
    void Reload() => RunSafely(() => App.Hub.Apply(new() { Operation = NotificationOperation.ReloadSettings }));

    /// <summary>Opens an application-owned portable directory on an explicit user action.</summary>
    /// <param name="path">The directory to create if needed and show.</param>
    static void OpenDirectory(string path) => RunSafely(() => { Directory.CreateDirectory(path); using Process? explorer = Process.Start(new ProcessStartInfo(path) { UseShellExecute = true }); });

    /// <summary>Resolves navigation text without exposing internal enum names.</summary>
    /// <param name="section">The work area.</param>
    /// <returns>Localized navigation label.</returns>
    static string SectionLabel(PanelSection section) => section switch { PanelSection.Inbox => Strings.Inbox, PanelSection.Scheduled => Strings.Scheduled, PanelSection.Sounds => Strings.Sounds, _ => Strings.SettingsTitle };

    /// <summary>Resolves a sorting option's translated label.</summary>
    /// <param name="order">The sort option.</param>
    /// <returns>Localized sorting label.</returns>
    static string SortLabel(SortOrder order) => ThemeStyle.Label(order);

    /// <summary>Releases journal and language subscriptions when this native surface is destroyed.</summary>
    public void Dispose() { App.Hub.Changed -= Changed; LocManager.LanguageChanged -= Changed; Reference?.Dispose(); }
}
