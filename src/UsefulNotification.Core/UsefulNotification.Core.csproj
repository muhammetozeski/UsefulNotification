<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup><TargetFramework>net10.0</TargetFramework><GenerateDocumentationFile>true</GenerateDocumentationFile><AssemblyName>UsefulNotification.Core</AssemblyName><AllowUnsafeBlocks>true</AllowUnsafeBlocks></PropertyGroup>
 <PropertyGroup>
  <PackageId>UsefulNotification.Core</PackageId>
  <Authors>muhammetozeski</Authors>
  <Description>Typed Windows notification contracts and client for the UsefulNotification desktop host.</Description>
  <PackageTags>notifications;windows;ipc</PackageTags>
  <PackageLicenseFile>LICENSE</PackageLicenseFile>
  <PackageReadmeFile>README.md</PackageReadmeFile>
  <PackageProjectUrl>https://github.com/muhammetozeski/UsefulNotification</PackageProjectUrl>
  <RepositoryUrl>https://github.com/muhammetozeski/UsefulNotification</RepositoryUrl>
  <RepositoryType>git</RepositoryType>
 </PropertyGroup>
 <ItemGroup>
  <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  <None Include="..\..\Sdk\README.md" Pack="true" PackagePath="\" />
 </ItemGroup>
 <ItemGroup>
  <PackageReference Include="Polly.Core" Version="8.7.0" />
  <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.363" PrivateAssets="all" />
  <InternalsVisibleTo Include="UsefulNotification" /><InternalsVisibleTo Include="UsefulNotification.Command" /><InternalsVisibleTo Include="UsefulNotification.Launcher" />
 </ItemGroup>
 <Import Project="Localization.resources.props" />
</Project>
